{
    "name": "hotkv/client",
    "description": "A high-performance PHP client for HotKV, a RESP2/RESP3-compatible in-memory data store with built-in AI and LLM-serving features.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://hotkv.com",
    "keywords": ["hotkv", "client", "sdk", "cache", "resp", "key-value"],
    "authors": [
        {
            "name": "HotKV Ltd",
            "homepage": "https://hotkv.com",
            "email": "support@hotkv.com"
        }
    ],
    "support": {
        "email": "support@hotkv.com",
        "issues": "https://github.com/hotkv-ltd/hotkv-php-client/issues",
        "source": "https://github.com/hotkv-ltd/hotkv-php-client"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "HotKV\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HotKV\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
